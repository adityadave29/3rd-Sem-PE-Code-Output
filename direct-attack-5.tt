Part 1:


Policy:
SET ROLE orders_admins;


CREATE POLICY orders_custkey_policy ON orders
   USING (o_custkey = current_setting('app.current_custkey', true)::int);


RESET ROLE;
psql -U alice -d tpch-200mb-2
SELECT current_setting('app.current_custkey', true);


SET app.current_custkey = '7381';
SELECT * FROM orders;


SET app.current_custkey = '999999';
SELECT * FROM orders;





